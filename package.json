{
    "name": "@divine-lab/has-query",
    "version": "2.0.6",
    "description": "A simple utility library for building GraphQL queries with caching support.",
    "author": {
        "name": "Ishpreet Singh",
        "email": "ishpreet@appshala.com",
        "github": "https://github.com/Ishpreet-Singh-Channa",
