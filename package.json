    },
    "license": "SEE LICENSE IN LICENSE",
    "keywords": [
        "graphql",
        "gql",
        "hasura",
        "utility"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist"
    ],
