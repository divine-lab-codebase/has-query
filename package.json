{
    "name": "@divine-lab/has-query",
    "version": "1.0.0",
    "description": "A simple utility library for building GraphQL queries with caching support.",
    "author": {
        "name": "Ishpreet Singh",
        "email": "ishpreet7521@gmail.com",
        "github": "https://github.com/Ishpreet-Singh-Channa",
        "linkedin": "https://www.linkedin.com/in/ishpreet-singh-5860ab257"
    },
    "license": "SEE LICENSE IN LICENSE",
    "keywords": [
        "graphql",
        "gql",
        "hasura",
        "redis",
        "utility"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        "./gql": {
            "default": "./dist/graph-ql/index.js",
            "types": "./dist/graph-ql/index.d.ts"
        },
        "./sql": {
            "default": "./dist/sql/query.js",
            "types": "./dist/sql/query.d.ts"
        },
        "./cache": {
            "default": "./dist/redis/index.js",
            "types": "./dist/redis/index.d.ts"
        }
    },
    "scripts": {
        "prepublishOnly": "tsc",
        "build": "tsc"
    },
    "dependencies": {
        "@divine-lab/logger": "^1.0.2",
        "@divine-lab/request": "^1.3.0",
        "redis": "^5.11.0"
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    }
}
